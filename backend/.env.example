PORT=5001
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/your_db
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
JWT_SECRET=your_jwt_secret_here
OPENAI_API_KEY=your_openai_api_key_here
CLIENT_URL=http://localhost:3000

# Public base URL of THIS backend (used to build email open-tracking pixel URLs).
# Must be reachable from the internet in production (e.g. https://api.greatodeal.com)
API_PUBLIC_URL=http://localhost:5001

# IMAP (reply detection + Inbox/Sent/Spam mailbox view). Defaults to the SMTP
# credentials above with host smtp.->imap. and port 993 if left unset.
# For Hostinger mailboxes this is typically imap.hostinger.com:993
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=your_email@example.com
IMAP_PASS=your_email_password
IMAP_ENABLED=true
IMAP_POLL_INTERVAL_MS=120000

# Lead Finder (admin panel): searches Google Places for companies by
# keyword + location, returning name/phone/website/address, then scans
# each website for a public contact email. Get a key at
# console.cloud.google.com -> APIs & Services -> enable "Places API (New)"
# -> Credentials -> Create API key. Requires a billing account attached
# to the project, but usage is free under Google Cloud's $200/month
# recurring credit for typical lead-search volumes.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
